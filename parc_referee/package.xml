<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>parc_referee</name>
  <version>1.0.0</version>
  <description>Referee, timer and dashboard for the PARC 2026 Real World Phase.</description>
  <maintainer email="info@parcrobotics.org">PARC Organisers</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>parc_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ros2bag</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
